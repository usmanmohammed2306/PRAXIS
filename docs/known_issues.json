  "issues": [
    {
      "id": "generic_id_vs_literal_grounding",
      "invariant": "Only adapter-declared ID fields require opaque ID grounding; semantic literals are not IDs.",
      "tests": [
        "test_iso_date_argument_is_not_treated_as_opaque_id",
        "test_adapter_declares_non_id_fields_for_grounding"
      ],
      "status": "verified"
    },
    {
      "id": "state_binding_user_text",
      "invariant": "User-provided facts bind immediately into typed state and semantic slots.",
      "tests": [
        "test_absorb_user_message_binds_airline_semantic_slots"
      ],
      "status": "verified"
    },
    {
      "id": "db_confirmed_precedence",
      "invariant": "Tool-confirmed facts outrank later weaker user claims and conflicts are recorded.",
      "tests": [
        "test_db_confirmed_semantic_slot_outranks_later_user_claim",
        "test_generic_kernel_records_conflict_without_overwriting_confirmed_fact"
      ],
      "status": "verified"
    },
    {
      "id": "auth_phase_reentry",
      "invariant": "Completed phases are locked and cannot be re-entered.",
      "tests": [
        "test_i1_completed_auth_phase_blocks_auth_tool_reentry"
      ],
      "status": "verified"
    },
    {
      "id": "hard_constraints_before_preferences",
      "invariant": "Hard constraints filter candidates before preferences or fallbacks rank them.",
      "tests": [
        "test_tau_retail_adapter_keeps_hard_constraints_separate_from_preferences",
        "test_g1_exchange_constraints_are_hard_filters"
      ],
      "status": "verified"
    },
    {
      "id": "partial_write_blocking",
      "invariant": "WRITE actions require task-level completeness and may not complete only a fragment.",
      "tests": [
        "test_h1_partial_write_is_blocked_by_completeness_gate",
        "test_i3_booking_write_requires_complete_slots"
      ],
      "status": "verified"
    },
    {
      "id": "global_constraint_decoy_rejection",
      "invariant": "Candidates that pass local constraints but fail global constraints are rejected.",
      "tests": [
        "test_acebench_adapter_rejects_local_pass_global_fail_decoy"
      ],
      "status": "verified"
    },
    {
      "id": "post_write_single_shot",
      "invariant": "Successful state-changing actions are recorded, duplicate writes are blocked, and the trajectory terminates when no fresh mutation remains.",
      "tests": [
        "test_f5_completed_mutation_gate_blocks_reexecution"
      ],
      "status": "verified"
    },
    {
      "id": "read_permissive_commit_strict",
      "invariant": "READ actions may retrieve grounded evidence while state is incomplete; semantic completeness is enforced only for WRITE/IRREVERSIBLE/FINAL.",
      "tests": [
        "test_read_permissive_allows_grounded_product_retrieval_with_incomplete_state",
        "test_i2_state_gate_blocks_search_conflicting_with_bound_date"
      ],
      "status": "verified"
    },
    {
      "id": "obligation_guided_airline_progress",
      "invariant": "Bound airline route/date/cabin facts create open obligations that pivot repeated ASK_USER/FINAL proposals into grounded READ actions.",
      "tests": [
        "test_airline_adapter_binds_booking_intent_and_open_obligation",
        "test_i2b_airline_ask_loop_pivots_to_bound_flight_search",
        "test_i2c_repeated_direct_search_pivots_to_onestop_when_allowed"
      ],
      "status": "verified"
    },
    {
      "id": "tool_observation_ids_are_not_semantic_constraints",
      "invariant": "Opaque IDs returned by tools remain grounded facts/typed evidence and do not become semantic-slot constraints that block later retrieval.",
      "tests": [
        "test_tool_observation_ids_do_not_become_semantic_slots"
      ],
      "status": "verified"
    },
    {
      "id": "v4_constraint_priority_decision_engine",
      "invariant": "Deterministic candidate selection filters hard constraints and availability before preferences or fallback rules.",
      "tests": [
        "test_v4_constraint_priority_selects_full_size_clicky_fallback",
        "test_v4_retail_adapter_rejects_wrong_keyboard_variant_from_latest_logs",
        "test_v4_retail_two_item_exchange_uses_deterministic_selected_candidates"
      ],
      "status": "verified"
    },
    {
      "id": "v4_candidate_set_search_exhaustion",
      "invariant": "READ results are stored as candidate sets with empty/exhausted status so identical failed searches do not loop.",
      "tests": [
        "test_v4_candidate_set_memory_records_empty_search_exhaustion",
        "test_v4_airline_exhausted_searches_finalize_instead_of_looping"
      ],
      "status": "verified"
    },
    {
      "id": "v4_pipeline_ask_policy",
      "invariant": "ASK_USER questions are allowed only for current-stage user-only slots; payment/certificate asks are premature before flight selection.",
      "tests": [
        "test_v4_airline_blocks_premature_payment_questions"
      ],
      "status": "verified"
    },
    {
      "id": "v4_forced_id_shape",
      "invariant": "Adapter-declared ID fields require typed evidence or an ID-looking grounded value; ordinary words cannot fill ID fields.",
      "tests": [
        "test_v4_forced_id_fields_reject_plain_words"
      ],
      "status": "verified"
    },
    {
      "id": "v4_retail_product_scoped_constraints",
      "invariant": "Retail adapter constraints are scoped to option keys present on the current product, and tau-retail adapter selection is authoritative over the legacy heuristic fallback.",
      "tests": [
        "test_v4_retail_adapter_rejects_wrong_keyboard_variant_from_latest_logs",
        "test_v4_retail_adapter_skips_keyboard_when_exact_spec_unavailable_and_user_says_other_only",
        "test_v4_retail_two_item_exchange_uses_deterministic_selected_candidates",
        "test_v4_retail_exact_keyboard_unavailable_commits_thermostat_only_when_requested"
      ],
      "status": "verified"
    },
    {
      "id": "v4_airline_identity_stage",
      "invariant": "Airline account/reservation tasks ask a precise user-id question before profile, reservation, search, or booking actions when identity is missing.",
      "tests": [
        "test_v4_airline_missing_user_id_asks_precisely_before_search"
      ],
      "status": "verified"
    },
    {
      "id": "v4_airline_airport_arg_canonicalization",
      "invariant": "Airline adapters translate user-facing city/location text into tool-native airport codes while semantic state validation accepts city/code equivalence; ambiguous regions match DB airport evidence without becoming guessed search args.",
      "tests": [
        "test_v4_airline_search_uses_airport_codes_but_matches_bound_city_state",
        "test_v4_airline_region_word_matches_db_airport_without_canonicalizing_search_to_guess"
      ],
      "status": "verified"
    },
    {
      "id": "v4_adapter_id_backstop",
      "invariant": "Adapter-declared ID fields reject ordinary words even when a synthesized tool schema omitted ID metadata.",
      "tests": [
        "test_v4_adapter_id_backstop_rejects_plain_word_when_schema_is_missing"
      ],
      "status": "verified"
    },
    {
      "id": "v4_structured_payment_id_evidence",
      "invariant": "Payment, card, and certificate IDs from structured order/profile caches are typed evidence for grounding.",
      "tests": [
        "test_h2_complete_canonical_write_passes_completeness_gate"
      ],
      "status": "verified"
    },
    {
      "id": "active_task_frame_quarantine",
      "invariant": "User-bound task-frame slots stay anchored; conflicting cached airline route/date/cabin/insurance/payment facts are evidence only and cannot overwrite the active goal.",
      "tests": [
        "test_tool_observation_does_not_overwrite_user_bound_task_frame",
        "test_v4_booking_goal_does_not_scan_unrelated_reservations"
      ],
      "status": "verified"
    },
    {
      "id": "booking_vs_reservation_stage_split",
      "invariant": "Airline booking goals search flights instead of scanning unrelated reservations; modify/cancel reservation goals scan only grounded reservation IDs.",
      "tests": [
        "test_v4_booking_goal_does_not_scan_unrelated_reservations",
        "test_v4_reservation_scan_skips_plain_words_and_none"
      ],
      "status": "verified"
    },
    {
      "id": "no_auth_catalog_stage_machine",
      "invariant": "Pure product/count goals route through catalog and product-detail READs before authentication and terminate after the computed answer.",
      "tests": [
        "test_v4_task_frame_routes_no_auth_product_query_before_auth",
        "test_v4_task_frame_fetches_product_details_after_catalog"
      ],
      "status": "verified"
    },
    {
      "id": "post_write_terminal_respond",
      "invariant": "Successful state-changing actions emit the terminal respond expected by the benchmark and stop when no fresh mutation remains.",
      "tests": [
        "test_v4_successful_write_emits_terminal_respond",
        "test_f5_completed_mutation_gate_blocks_reexecution"
      ],
      "status": "verified"
    },
    {
      "id": "v4_airline_task_frame_isolation",
